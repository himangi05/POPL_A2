
; Calls appended to the end of code/33_q3.rkt by run_s1.sh (the grader does the same).
; The trees are defined here; every tree gets the same three calls, in this order:
;   print-inorder, print-all-traversals, print-height-and-leaves  (5 lines of output per tree)

(define t1 '(4 (2 (1 () ()) (3 () ())) (6 (5 () ()) (7 () ()))))
(define t2 '(1 () (2 () (3 () ()))))
(define t3 '(a (b () ()) (c () ())))
(define t-single '(5 () ()))
(define t4 '(1 (2 (3 () ()) ()) (4 () ())))   ; unbalanced: the deeper side is the left
(define t5 '(1 (2 (3 () ()) (4 () ())) ()))   ; root has only a left child; two leaves below it
(define t6 '(1 () (2 (3 () ()) (4 () ()))))   ; root has only a right child; two leaves below it

; left-leaning chain of n nodes: root 1, its left child 2, ... the deepest node n (no right children)
(define (left-chain n)
  (let loop ((i n) (t '()))
    (if (= i 0) t (loop (- i 1) (list i t '())))))
; right-leaning chain of n nodes: root 1, its right child 2, ... (no left children)
(define (right-chain n)
  (let loop ((i n) (t '()))
    (if (= i 0) t (loop (- i 1) (list i '() t)))))

(print-inorder t1)            (print-all-traversals t1)       (print-height-and-leaves t1)
(print-inorder t2)            (print-all-traversals t2)       (print-height-and-leaves t2)
(print-inorder t3)            (print-all-traversals t3)       (print-height-and-leaves t3)
(print-inorder '())           (print-all-traversals '())      (print-height-and-leaves '())
(print-inorder t-single)      (print-all-traversals t-single) (print-height-and-leaves t-single)
(print-inorder t4)            (print-all-traversals t4)       (print-height-and-leaves t4)
(print-inorder t5)            (print-all-traversals t5)       (print-height-and-leaves t5)
(print-inorder t6)            (print-all-traversals t6)       (print-height-and-leaves t6)

; deep trees: 1000 nodes. Their expected output is generated by run_s1.sh with seq.
(print-inorder (left-chain 1000))
(print-all-traversals (left-chain 1000))
(print-height-and-leaves (left-chain 1000))
(print-inorder (right-chain 1000))
(print-all-traversals (right-chain 1000))
(print-height-and-leaves (right-chain 1000))